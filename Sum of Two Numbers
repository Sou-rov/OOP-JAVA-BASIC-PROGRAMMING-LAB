import java.util.Scanner;
public class SUM
{
    public static void main(String[] args) 
    {
        Scanner input = new Scanner(System.in);
        System.out.print("First number: ");
        int a = input.nextInt();
        System.out.print("Second number: ");
        int b = input.nextInt();
        int sum = a + b;
        System.out.println("Sum = " + sum);
    }
}
